{
  "$comment": "Single source of the design language. The mobile app (mobile/) uses an identical copy. Change here first.",
  "color": {
    "brand": { "50": "#EEF4FA", "100": "#D6E4F2", "200": "#ADC9E4", "300": "#7FA8D1", "400": "#4F82B6", "500": "#2E6599", "600": "#1F4E78", "700": "#193F62", "800": "#14324E", "900": "#0E2438" },
    "accent": { "50": "#FFF8EB", "100": "#FEEBC8", "300": "#F9C46B", "500": "#F29F05", "600": "#D18603", "700": "#A86A03" },
    "success": { "50": "#ECFDF3", "100": "#D1FADF", "600": "#16A34A", "700": "#15803D" },
    "warning": { "50": "#FFFAEB", "100": "#FEF0C7", "600": "#D97706", "700": "#B45309" },
    "danger": { "50": "#FEF3F2", "100": "#FEE4E2", "600": "#DC2626", "700": "#B91C1C" },
    "info": { "50": "#EFF8FF", "100": "#D1E9FF", "600": "#2563EB", "700": "#1D4ED8" },
    "ink": { "DEFAULT": "#101828", "muted": "#475467", "subtle": "#667085", "inverse": "#FFFFFF" },
    "surface": { "DEFAULT": "#FFFFFF", "muted": "#F6F8FB", "sunken": "#EEF1F5", "overlay": "rgba(16,24,40,0.55)" },
