# Production build settings (used by `vite build`, e.g. on Vercel). Public values only:
# everything VITE_* ends up in the browser bundle. Vercel project env vars override these.
VITE_API_URL=https://realestatebackend-itm7.onrender.com/api
VITE_HOTLINE=+91 80000 00000
VITE_APP_NAME=PropertyDirect
# Show the clickable demo logins on the sign-in page (demo deployment). Set to false for the real launch.
VITE_SHOW_DEMO_LOGINS=true
# Fixed one-time code shown in the demo box (must match the backend DEMO_OTP_CODE). Remove for the real launch.
VITE_DEMO_OTP_CODE=123456
